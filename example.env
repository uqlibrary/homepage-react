# duplicate this file as .env
# restart mock to apply a change in any of these values
NODE_PATH=src/
GOOGLE_MAPS_API_KEY='key'
HOMEPAGE_STAGING_HOST=https://staging
#API_URL='http://dev-api.library.uq.edu.au:8050/'
#API_URL='https://api.library.uq.edu.au/staging/'
#BARCODE_SCANNER_WASM_PATH='/vendor/reader.wasm' // works with both remote or local paths

# AWS WAF CAPTCHA on the membership form. Normal local dev uses the mock (npm run start:mock) and needs
# neither of these. Set them only to test a real AWS WAF puzzle against a non-mock dev server. Leave blank = off.
#AWS_WAF_CAPTCHA_INTEGRATION_URL='https://<id>.<region>.captcha.awswaf.com'
#AWS_WAF_CAPTCHA_API_KEY='your-encrypted-domain-scoped-key'
